---
// Sticky nav bar — shows its scrolled state once the hero has scrolled past.
// No cross-page navigation (site is single-scroll per PAGE STRUCTURE).
---

<header class="topbar" data-sticky-nav>
  <div class="wrap topbar-inner">
    <div class="wordmark">Pacific Fairways<small>Springwood, QLD</small></div>
    <div class="topbar-actions">
      <a class="phone-link" href="tel:+61712345678">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.9 21 3 13.1 3 3.9c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.4 0 .8-.2 1l-2.3 2.3z"/></svg>
        <span>(07) 1234 5678</span>
      </a>
      <a class="btn btn-outline-dark btn-sm" href="#enquire-footer">Enquire Now</a>
    </div>
  </div>
</header>

<style>
  .topbar {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 40;
    background: color-mix(in srgb, var(--color-ink, var(--color-primary)) 92%, transparent);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--color-hairline-dark, rgba(0, 0, 0, 0.3));
    box-shadow: 0 0 0 0 rgba(0, 0, 0, 0);
    transition: background 0.4s ease, box-shadow 0.4s ease;
  }
  .topbar.is-scrolled {
    background: var(--color-ink, var(--color-primary));
    box-shadow: 0 10px 30px -12px rgba(0, 0, 0, 0.4);
  }
  @media (prefers-reduced-motion: reduce) {
    .topbar {
      transition: none;
    }
  }
  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 14px;
  }
  .wordmark {
    font-family: var(--font-display);
    color: var(--color-on-ink, var(--color-bg));
    font-size: 19px;
    letter-spacing: 0.06em;
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .wordmark small {
    font-family: var(--font-body);
    font-size: 9.5px;
    letter-spacing: 0.24em;
    color: var(--color-accent-light, var(--color-accent));
    font-weight: 600;
    margin-top: 2px;
  }
  .topbar-actions {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .phone-link {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 14.5px;
    color: var(--color-on-ink, var(--color-bg));
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 7px;
    white-space: nowrap;
  }
  .phone-link svg {
    flex: none;
  }
  @media (max-width: 560px) {
    .phone-link span {
      display: none;
    }
  }
</style>

<script>
  const topbar = document.querySelector('[data-sticky-nav]');
  const hero = document.getElementById('hero');
  if (topbar && hero && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          topbar.classList.toggle('is-scrolled', !entry.isIntersecting);
        });
      },
      { rootMargin: '-70% 0px 0px 0px' },
    );
    io.observe(hero);
  }
</script>
