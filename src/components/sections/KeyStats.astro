---
// KeyStats — full-width dark band, 4 stat blocks with a rolling-odometer
// reveal. Optional, renders only when selected in Q1 Field 9.
---

<section class="stats w-full" aria-label="Key stats" data-reveal-group>
  <div class="wrap stats-inner">
    <div class="stats-head reveal">
      <h2>Pacific Fairways, in brief.</h2>
      <span class="eyebrow on-dark">Full Release — All Lots</span>
    </div>
    <div class="stat-grid">
      <div class="stat reveal"><div class="stat-value"><span class="num" data-target="20">20</span></div><span class="stat-rule"></span><div class="stat-label">Lots Available</div></div>
      <div class="stat reveal"><div class="stat-value"><span class="num" data-target="1000" data-format="comma">1,000</span>m²</div><span class="stat-rule"></span><div class="stat-label">Lot Sizes</div></div>
      <div class="stat reveal"><div class="stat-value">$<span class="num" data-target="1.2" data-decimals="1">1.2</span>m</div><span class="stat-rule"></span><div class="stat-label">From</div></div>
      <div class="stat reveal"><div class="stat-value"><span class="num" data-target="22">22</span>km</div><span class="stat-rule"></span><div class="stat-label">to Brisbane CBD · ~25 min</div></div>
    </div>
  </div>
</section>

<style>
  .stats {
    background: var(--color-ink, var(--color-primary));
    color: var(--color-on-ink, var(--color-bg));
    position: relative;
  }
  .stats::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.035) 0 1px,
      transparent 1px 64px
    );
  }
  .stats-inner {
    position: relative;
  }
  .stats-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 44px;
  }
  .stats-head h2 {
    color: var(--color-on-ink, var(--color-bg));
    font-size: clamp(22px, 2.8vw, 30px);
  }
  .stat-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  @media (max-width: 820px) {
    .stat-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .stat {
    padding: 22px 26px;
    border-left: 1px solid var(--color-hairline-dark, rgba(255, 255, 255, 0.2));
    position: relative;
  }
  .stat:first-child {
    border-left: none;
  }
  @media (max-width: 820px) {
    .stat:nth-child(odd) {
      border-left: none;
    }
    .stat {
      border-top: 1px solid var(--color-hairline-dark, rgba(255, 255, 255, 0.2));
    }
    .stat:nth-child(-n + 2) {
      border-top: none;
    }
  }
  /* phone: a swipeable strip, not a squeezed grid — the card peeking at the
     edge signals "scroll" without an instructional label */
  @media (max-width: 640px) {
    .stat-grid {
      display: flex;
      grid-template-columns: none;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      margin-inline: -18px;
      padding-inline: 18px;
    }
    .stat-grid::-webkit-scrollbar {
      display: none;
    }
    .stat {
      flex: 0 0 76%;
      scroll-snap-align: start;
      border-top: none !important;
    }
    .stat:nth-child(odd) {
      border-left: 1px solid var(--color-hairline-dark, rgba(255, 255, 255, 0.2)) !important;
    }
    .stat:first-child {
      border-left: none !important;
    }
  }
  .stat-value {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-weight: 500;
    font-size: clamp(28px, 3.6vw, 42px);
    color: var(--color-bg);
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }
  .stat-label {
    margin-top: 12px;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-light, var(--color-accent));
    font-weight: 600;
  }
  .stat-rule {
    display: block;
    width: 26px;
    height: 2px;
    margin-top: 14px;
    background: var(--color-accent-light, var(--color-accent));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.7s var(--ease, ease) 0.1s;
  }
  .stat.reveal-in .stat-rule {
    transform: scaleX(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .stat-rule {
      transform: scaleX(1);
      transition: none;
    }
  }

  /* rolling odometer digits — each digit is a 0-9 strip in a 1-line window;
     revealing a stat slides the strip up to land on the real value */
  :global(.odometer) {
    display: inline-flex;
    align-items: baseline;
  }
  :global(.odo-digit) {
    display: inline-block;
    position: relative;
    overflow: hidden;
    height: 1em;
    width: 0.64ch;
    vertical-align: -0.14em;
    transform: translateZ(0);
    backface-visibility: hidden;
  }
  :global(.odo-strip) {
    display: flex;
    flex-direction: column;
    transform: translateY(0) translateZ(0);
    backface-visibility: hidden;
    transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }
  :global(.odo-row) {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 1em;
    flex: 0 0 1em;
    backface-visibility: hidden;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.odo-strip) {
      transition: none;
    }
  }
</style>
