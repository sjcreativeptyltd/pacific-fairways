---
// EnquireFooter — enquiry form (Formspree via the EnquiryForm island),
// developer contact details, privacy line. Standard section, always
// rendered, doubles as the page footer.
import EnquiryForm from '../react/EnquiryForm';
---

<footer id="enquire-footer" class="enquire w-full" data-reveal-group>
  <div class="wrap enquire-grid">
    <div class="reveal">
      <span class="eyebrow on-dark">Enquire</span>
      <h2>Secure Your Lot Today</h2>
      <p class="enquire-lede">
        Register your interest in Pacific Fairways and our sales team will be
        in touch with lot availability, pricing and next steps.
      </p>

      <div class="contact-block">
        <div class="contact-wordmark">Pacific Fairways<small>Springwood, QLD</small></div>
        <p class="logo-note">Developer / agent logo to be supplied — placeholder wordmark shown.</p>
        <div class="contact-rows">
          <a class="row" href="tel:+61712345678">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.9 21 3 13.1 3 3.9c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.4 0 .8-.2 1l-2.3 2.3z"/></svg>
            (07) 1234 5678
          </a>
          <a class="row" href="mailto:sales@pacificfairways.email">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
            sales@pacificfairways.email
          </a>
          <span class="row">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s7-6.1 7-11.4A7 7 0 0 0 5 9.6C5 14.9 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.4"/></svg>
            Sales Centre — By appointment only
          </span>
        </div>
      </div>
    </div>

    <div class="reveal">
      <EnquiryForm client:load />
    </div>
  </div>

  <div class="wrap foot-bottom">
    <span>© Pacific Fairways. Images are artist impressions and indicative only.</span>
  </div>
</footer>

<style>
  .enquire {
    background: var(--color-ink, var(--color-primary));
    color: var(--color-on-ink, var(--color-bg));
    /* .enquire is a <footer>, not a <section> — the sitewide
       `section{padding-block:88px}` rule in global.css doesn't reach it,
       so without this it sits flush against whatever's above it. */
    padding-block: 88px;
  }
  @media (max-width: 640px) {
    .enquire {
      padding-block: 60px;
    }
  }
  .enquire-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
  }
  @media (max-width: 900px) {
    .enquire-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
  .enquire h2 {
    color: var(--color-on-ink, var(--color-bg));
    font-size: clamp(26px, 3.4vw, 36px);
    margin-top: 12px;
    max-width: 14ch;
  }
  .enquire-lede {
    margin-top: 16px;
    font-size: 15.5px;
    line-height: 1.7;
    color: var(--color-on-ink, var(--color-bg));
    opacity: 0.78;
    max-width: 44ch;
  }

  .contact-block {
    margin-top: 44px;
    padding-top: 32px;
    border-top: 1px solid var(--color-hairline-dark, rgba(255, 255, 255, 0.2));
  }
  .contact-wordmark {
    font-family: var(--font-display);
    font-size: 22px;
    letter-spacing: 0.05em;
    color: var(--color-on-ink, var(--color-bg));
  }
  .contact-wordmark small {
    display: block;
    font-family: var(--font-body);
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--color-accent-light, var(--color-accent));
    margin-top: 6px;
    font-weight: 600;
  }
  .contact-rows {
    margin-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 14.5px;
  }
  .contact-rows a {
    text-decoration: none;
    color: var(--color-on-ink, var(--color-bg));
  }
  .contact-rows .row {
    display: flex;
    gap: 12px;
    align-items: center;
    opacity: 0.9;
  }
  .contact-rows svg {
    flex: none;
    opacity: 0.75;
  }
  .logo-note {
    margin-top: 26px;
    font-size: 11.5px;
    color: var(--color-on-ink, var(--color-bg));
    opacity: 0.45;
    font-style: italic;
  }

  .foot-bottom {
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid var(--color-hairline-dark, rgba(255, 255, 255, 0.2));
    font-size: 11.5px;
    color: var(--color-on-ink, var(--color-bg));
    opacity: 0.45;
  }

  /* The form itself renders via the client-loaded EnquiryForm island, so
     these selectors need :global — Astro's scoping attribute never reaches
     into a React island's own render output. */
  :global(.enquiry-form .field) {
    margin-bottom: 18px;
    position: relative;
  }
  :global(.enquiry-form .field label) {
    display: block;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent-light, var(--color-accent));
    font-weight: 600;
    margin-bottom: 8px;
    transition: color 0.3s ease;
  }
  :global(.enquiry-form .field:focus-within label) {
    color: var(--color-on-ink, var(--color-bg));
  }
  :global(.enquiry-form .field input),
  :global(.enquiry-form .field textarea) {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--color-hairline-dark, rgba(255, 255, 255, 0.2));
    color: var(--color-on-ink, var(--color-bg));
    font-family: var(--font-body);
    font-size: 15.5px;
    padding: 10px 2px;
  }
  :global(.enquiry-form .field input:focus),
  :global(.enquiry-form .field textarea:focus) {
    outline: none;
  }
  :global(.enquiry-form .field::after) {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 1.5px;
    background: var(--color-accent-light, var(--color-accent));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease, ease);
  }
  :global(.enquiry-form .field:focus-within::after) {
    transform: scaleX(1);
  }
  :global(.enquiry-form .field textarea) {
    resize: vertical;
    min-height: 70px;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.enquiry-form .field label),
    :global(.enquiry-form .field::after) {
      transition: none;
    }
  }
  :global(.enquiry-form .field-row) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  @media (max-width: 480px) {
    :global(.enquiry-form .field-row) {
      grid-template-columns: 1fr;
    }
  }
  :global(.enquiry-form .form-foot) {
    margin-top: 8px;
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }
  :global(.enquiry-form .privacy) {
    font-size: 12px;
    line-height: 1.6;
    color: var(--color-on-ink, var(--color-bg));
    opacity: 0.55;
    max-width: 52ch;
  }
  :global(.enquiry-form button[disabled]) {
    opacity: 0.6;
    cursor: default;
  }
  :global(.enquiry-form .form-error) {
    margin-top: 12px;
    font-size: 13px;
    color: var(--color-accent-light, var(--color-accent));
  }
  :global(.enquiry-done) {
    font-family: var(--font-display);
    font-size: 20px;
    color: var(--color-on-ink, var(--color-bg));
  }
</style>
