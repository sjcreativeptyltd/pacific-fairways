---
// LocationHighlights — light-background section, headline + six
// icon-labelled location bullets. Optional, renders only when selected.
---

<section id="location-highlights" class="location w-full" data-reveal-group>
  <div class="wrap">
    <div class="loc-head reveal">
      <span class="eyebrow on-light">Location</span>
      <h2>Set among it, close to everything.</h2>
    </div>
    <div class="loc-grid">
      <div class="loc-item reveal">
        <span class="loc-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-6.1 7-11.4A7 7 0 0 0 5 9.6C5 14.9 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.4"/></svg></span>
        <p class="loc-text">22km / ~25 min to Brisbane CBD</p>
      </div>
      <div class="loc-item reveal">
        <span class="loc-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l4 6h-2.5l4 6H14v6h-4v-6H6.5l4-6H8z"/></svg></span>
        <p class="loc-text">Walking distance to Springwood Conservation Park</p>
      </div>
      <div class="loc-item reveal">
        <span class="loc-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 2 8l10 5 10-5-10-5z"/><path d="M6 11v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5"/></svg></span>
        <p class="loc-text">Zoned for Springwood State High School</p>
      </div>
      <div class="loc-item reveal">
        <span class="loc-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9l1.5-5h13L20 9"/><rect x="4" y="9" width="16" height="11" rx="1"/><path d="M9 20v-5h6v5"/></svg></span>
        <p class="loc-text">Minutes to Springwood Mall for everyday shopping</p>
      </div>
      <div class="loc-item reveal">
        <span class="loc-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 21l1.2-13.5a1 1 0 0 1 1-.9h1.6a1 1 0 0 1 1 .9L11 21"/><path d="M11 21V9.5l7.4-4.2a.6.6 0 0 1 .9.6l-1 5.4-5.3 1.4"/></svg></span>
        <p class="loc-text">Adjacent to Pacific Fairway Golf Course</p>
      </div>
      <div class="loc-item reveal">
        <span class="loc-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="5" width="16" height="11" rx="2"/><path d="M4 12h16"/><circle cx="8" cy="19" r="1.4"/><circle cx="16" cy="19" r="1.4"/></svg></span>
        <p class="loc-text">Easy access to Springwood Bus Station and the Pacific Motorway</p>
      </div>
    </div>
  </div>
</section>

<style>
  .location {
    background: var(--color-bg);
  }
  /* editorial label-left head — deliberately not the centered .section-head
     pattern used elsewhere, so the page doesn't read as one component repeated */
  .loc-head {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 24px;
    align-items: end;
    margin-bottom: 40px;
  }
  .loc-head .eyebrow {
    padding-bottom: 6px;
  }
  .loc-head h2 {
    font-size: clamp(24px, 3vw, 34px);
  }
  @media (max-width: 640px) {
    .loc-head {
      grid-template-columns: 1fr;
      gap: 8px;
      align-items: start;
    }
  }
  .loc-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--color-hairline, rgba(0, 0, 0, 0.12));
    border: 1px solid var(--color-hairline, rgba(0, 0, 0, 0.12));
    margin-top: 8px;
  }
  @media (max-width: 640px) {
    .loc-grid {
      grid-template-columns: 1fr;
    }
  }
  .loc-item {
    background: var(--color-bg-alt);
    padding: 26px 28px;
    display: flex;
    gap: 16px;
    align-items: flex-start;
    transition: background 0.35s ease;
  }
  .loc-item:hover {
    background: var(--color-paper, var(--color-bg));
  }
  .loc-icon {
    flex: none;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--color-paper, var(--color-bg));
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-hairline, rgba(0, 0, 0, 0.12));
    transition: background 0.3s ease, border-color 0.3s ease;
  }
  .loc-icon svg {
    width: 20px;
    height: 20px;
    stroke: var(--color-primary);
    transition: stroke 0.3s ease;
  }
  .loc-item:hover .loc-icon {
    background: var(--color-primary);
    border-color: var(--color-primary);
  }
  .loc-item:hover .loc-icon svg {
    stroke: var(--color-on-ink, var(--color-bg));
  }
  .loc-text {
    font-size: 15.5px;
    line-height: 1.55;
    padding-top: 6px;
  }
  @media (prefers-reduced-motion: reduce) {
    .loc-item,
    .loc-icon,
    .loc-icon svg {
      transition: none;
    }
  }
</style>
